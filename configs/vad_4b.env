# Reproduction-oriented 4B profile. Every assignment remains overridable from
# the calling environment.
MODEL_PATH="${MODEL_PATH:-Qwen/Qwen3.5-4B}"
TEACHER_MODEL_PATH="${TEACHER_MODEL_PATH:-${MODEL_PATH}}"

TRAIN_BATCH_SIZE="${TRAIN_BATCH_SIZE:-96}"
PPO_MINI_BATCH_SIZE="${PPO_MINI_BATCH_SIZE:-96}"
ROLLOUT_N="${ROLLOUT_N:-8}"
LEARNING_RATE="${LEARNING_RATE:-2e-6}"

TRAINER_TOTAL_EPOCHS="${TRAINER_TOTAL_EPOCHS:-2}"
TOTAL_TRAINING_STEPS="${TOTAL_TRAINING_STEPS:-130}"
TRAINER_SAVE_FREQ="${TRAINER_SAVE_FREQ:-10}"

VC_POSITIVE_BUDGET_CAP="${VC_POSITIVE_BUDGET_CAP:-0.8}"
VC_NONVISUAL_ANCHOR_ETA="${VC_NONVISUAL_ANCHOR_ETA:-0.1}"
ROLLOUT_GPU_MEMORY_UTILIZATION="${ROLLOUT_GPU_MEMORY_UTILIZATION:-0.70}"

PROFILE_LABEL="${PROFILE_LABEL:-qwen35-4b}"
